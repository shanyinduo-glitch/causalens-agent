# Required
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: 单模型兼容配置
# MODEL_NAME=qwen3.8-flash

# Recommended: 仅填写已在百炼控制台开启“免费额度用完即停”的模型。
# 按顺序尝试；只有明确返回免费额度耗尽 403 时才切换。
# FREE_MODEL_CANDIDATES=qwen3.8-flash,qwen3.7-flash-2026-07-15

# 单次工作流最多调用模型的次数，防止意外消耗免费额度。
# CAUSALENS_MAX_LLM_CALLS_PER_RUN=6

# 请求超时秒数；SDK 隐式重试已禁用。
# DASHSCOPE_TIMEOUT_SECONDS=60

# Optional
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
